APP_NAME="PayNexa Backend API"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./paynexa.db

# LLM Provider Configuration (Gemini as sole active provider)
LLM_PROVIDER_TYPE=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
LLM_TIMEOUT_SECONDS=3.0

# Optional legacy keys (not required or called)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ML Prediction Engine
ML_MODEL_NAME=recovery_probability_model
MODEL_NAME=recovery_probability_model
MODEL_VERSION=1.0.0
FEATURE_VERSION=1.0.0
